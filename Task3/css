@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Cairo', sans-serif;
    background: linear-gradient(135deg, #cdb4db, #ffc8dd, #bde0fe);
    min-height: 100vh;
    padding: 40px;
    color: #4a3b57;
}

.container {
    max-width: 1200px;
    margin: auto;
    background: rgba(255, 255, 255, 0.9);
    padding: 40px;
    border-radius: 30px;
    box-shadow: 0 15px 35px rgba(123, 94, 167, 0.25);
    border: 3px solid #cdb4db;
}

h1 {
    text-align: center;
    font-size: 45px;
    color: #7b5ea7;
    margin-bottom: 25px;
    font-weight: 800;
}

.welcome {
    text-align: center;
    font-size: 32px;
    margin-bottom: 25px;
    font-weight: 700;
}

.red {
    color: #cdb4db;
}

.blue {
    color: #a2d2ff;
}

.green {
    color: #ffafcc;
}

.yellow {
    color: #7b5ea7;
}

p {
    text-align: center;
    font-size: 21px;
    margin-bottom: 30px;
    color: #5f4b75;
}

h2 {
    color: #7b5ea7;
    margin: 35px 0 20px;
    font-size: 30px;
    border-right: 7px solid #ffafcc;
    padding-right: 14px;
}

.files {
    list-style: none;
    margin-bottom: 30px;
}

.files li {
    margin-bottom: 16px;
}

.files a {
    display: block;
    text-decoration: none;
    background: linear-gradient(135deg, #ffc8dd, #cdb4db);
    color: #4a3b57;
    padding: 16px 22px;
    border-radius: 18px;
    transition: 0.3s ease;
    font-size: 19px;
    font-weight: 700;
    box-shadow: 0 6px 16px rgba(123, 94, 167, 0.15);
}

.files a:hover {
    background: linear-gradient(135deg, #cdb4db, #a2d2ff);
    color: white;
    transform: translateY(-4px);
}

.studentTable {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 25px;
}

.studentTable tr:first-child {
    display: none;
}

.studentTable tr {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.2fr 0.8fr 260px;
    align-items: center;
    background: linear-gradient(135deg, #ffffff, #f8f0ff);
    border-radius: 28px;
    padding: 20px;
    box-shadow: 0 12px 28px rgba(123, 94, 167, 0.18);
    border: 2px solid #cdb4db;
    transition: 0.3s ease;
}

.studentTable tr:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 35px rgba(123, 94, 167, 0.28);
    background: linear-gradient(135deg, #fff4fa, #edf7ff);
}

.studentTable td {
    text-align: center;
    padding: 12px;
    font-size: 19px;
    font-weight: 600;
    color: #4a3b57;
}

.credit {
    color: #7b5ea7;
    font-weight: 800;
    background-color: #ffc8dd;
    border-radius: 15px;
    padding: 10px;
}

.studentTable img {
    width: 240px;
    height: 150px;
    object-fit: cover;
    border-radius: 22px;
    border: 4px solid #cdb4db;
    box-shadow: 0 8px 20px rgba(123, 94, 167, 0.3);
    transition: 0.3s ease;
}

.studentTable img:hover {
    transform: scale(1.05);
}

.langButton {
    text-align: center;
    margin-top: 40px;
}

.langButton a {
    display: inline-block;
    text-decoration: none;
    background: linear-gradient(135deg, #7b5ea7, #cdb4db);
    color: white;
    padding: 16px 34px;
    border-radius: 18px;
    font-size: 19px;
    font-weight: 800;
    transition: 0.3s ease;
    box-shadow: 0 8px 18px rgba(123, 94, 167, 0.25);
}

.langButton a:hover {
    background: linear-gradient(135deg, #ffafcc, #a2d2ff);
    color: #4a3b57;
    transform: scale(1.06);
}
